#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
"""Source cut into the units an engineer would name it by.

A file is not a useful unit of retrieval and a fixed window is worse:
half a function tells you it exists and not what it does. Tree-sitter
gives the units the language itself defines — a module, an entity, a
`do_install`, a device tree node — and each is indexed with the lines
it occupies, so a hit is a place in a file rather than a file.

Runs inside the container, with no network and the source mounted
read-only. Prints one JSON object on stdout. Source is data here, not
a program: nothing is executed, only parsed.

Where a grammar gets nothing out of a file the file is cut on blank
lines instead, and the answer says so and why. The design notes
expect this of the community-maintained grammars, and the test is
what came out rather than how many error nodes the parse contains:
measured here, tree-sitter-c leaves 84% of a preprocessor-heavy
tclAppInit.c inside error nodes and still finds `main` and
`Tcl_AppInit` at the right lines, which is the whole point, while
tree-sitter-tcl fails on a 1370-line git-gui file so completely that
the tree holds no unit at all and one blob of the entire file. The
first is worth keeping and the second is not.
"""

from __future__ import annotations

import json
import os
import sys
from dataclasses import asdict, dataclass
from pathlib import Path

from tree_sitter import Node
from tree_sitter_language_pack import PackConfig, configure, get_parser

