# Nodes that hold units of their own. The container is not emitted as
# one unit with everything in it; what comes before its first inner
# unit is, which for a module is its ports and parameters and for a
# recipe is SUMMARY, LICENSE, SRC_URI and DEPENDS. That keeps "what
# are the ports of X" answerable without indexing the module twice.
INSIDE: dict[str, frozenset[str]] = {
    "verilog": frozenset(
        {
            "module_declaration",
            "package_declaration",
            "interface_declaration",
            "class_declaration",
        }
    ),
    "vhdl": frozenset({"architecture_body", "package_body"}),
    "devicetree": frozenset({"node"}),
    "kconfig": frozenset({"menu", "choice"}),
    "tcl": frozenset({"namespace"}),
}
INSIDE["systemverilog"] = INSIDE["verilog"]
# A Rust impl block holds the methods, and a module with a body holds
# everything; both are worth descending into so that a method is its
# own unit rather than a line inside a four-hundred-line impl.
INSIDE["rust"] = frozenset({"impl_item", "mod_item", "trait_item"})

# Constructs with nothing to be named by. An always block has no name
# and `named` would otherwise return the first thing in its event
# list, so "always @(posedge clk)" came out called "clk"; a VHDL
# process has a label only sometimes and a sensitivity list always.
# These are named by the lines they occupy, which is the citation
# anyway.
NAMELESS = frozenset(
    {
        "always_construct",
        "initial_construct",
        "process_statement",
        "continuous_assign",
    }
)

# Wrappers that carry no meaning of their own and are walked through.
CLEAR = frozenset({"design_unit", "source_file", "translation_unit"})

# Where a name is kept, across grammars. The first descendant of one
# of these types, not crossing into a nested unit, is the name.
NAMES = frozenset(
    {
        "identifier",
        "type_identifier",
        "simple_identifier",
        "simple_name",
        "simple_word",
        "word",
        "targets",
        "name",
        "field_identifier",
        "variable_name",
        # Kconfig names a menu by its prompt. It is last in the set
        # only in spirit: `named` works outward from the node, so a
        # declaration's identifier is always found before a string
        # deeper inside it.
        "string",
    }
)

# A unit longer than this is cut, because the embedding model holds
# 8192 tokens and a generated register file can be one declaration of
# forty thousand lines.
UNIT_CHARS = 6000
# Below this a run of leading declarations is not worth its own unit.
MIN_GROUP = 40
# A parse that puts this much of the file into one unnamed group is
# not a parse. tree-sitter-tcl returns the whole of git-gui's
# blame.tcl that way, and a citation reading "lines 1-1370" tells a
# reader nothing they did not have before asking.
MAX_GROUP_SHARE = 0.9

# What one file says about another, or about a name. Read off the same
# tree as the units, because a graph built by regular expression gets
# a module name out of a comment and an instantiation out of a string
# literal. Each entry is a node type and the kind of edge it makes;
# the name is the first identifier under it, which was checked against
# every grammar rather than assumed.
EDGES: dict[str, dict[str, str]] = {
    "c": {
        "preproc_include": "include",
        "call_expression": "call",
    },
    "verilog": {
        "include_compiler_directive": "include",
        "package_import_declaration": "use",
        "module_instantiation": "instantiate",
    },
    "vhdl": {
        "use_clause": "use",
        "component_instantiation": "instantiate",
        "entity_instantiation": "instantiate",
        "component_declaration": "declare",
    },
    "bitbake": {
        "inherit_directive": "inherit",
        "require_directive": "require",
        "include_directive": "require",
    },
}
EDGES["rust"] = {
    "use_declaration": "use",
    "mod_item": "include",
    "call_expression": "call",
    "macro_invocation": "call",
}
EDGES["go"] = {
    "import_spec": "include",
    "call_expression": "call",
}
EDGES["cpp"] = EDGES["c"]
EDGES["systemverilog"] = EDGES["verilog"]

# Variables whose value is a list of other recipes. The graph wants
# the names in them, not the string: DEPENDS = "zlib openssl" is two
# edges. The override stays on the variable so that a question about
# which layer sets RDEPENDS:${PN} can be answered.
BITBAKE_LISTS = frozenset({"DEPENDS", "RDEPENDS", "PROVIDES", "RPROVIDES"})
# Commands that pull in another file, by language. A `source` in a
# shell script and a `source` in a constraint file mean the same thing
# and the grammars spell them differently.
SOURCES = {"bash": frozenset({"source", "."}), "tcl": frozenset({"source"})}
# Where a name inside a quoted or dotted reference ends. VHDL writes
# `work.debouncer` and `ieee.std_logic_1164.all`; the thing being
# referred to is the last part that is not `all`.
TAIL_SKIP = frozenset({"all", ""})


@dataclass
class Edge:
    """One reference from this file to a name outside the unit."""

    kind: str
    name: str
    line: int


@dataclass
class Unit:
    """One citable piece of a file."""

    kind: str
    name: str
    first_line: int
    last_line: int
    text: str


def language_of(path: Path) -> str:
    found = BY_NAME.get(path.name)
    if found:
        return found
    if path.name.startswith("Kconfig"):
        return "kconfig"
    if path.name.startswith("Makefile"):
        return "make"
    return BY_SUFFIX.get(path.suffix.lower(), "")


def text_of(node: Node) -> str:
    return (node.text or b"").decode(errors="replace").strip()


def last_line(node: Node) -> int:
    """The last line the node actually occupies, counting from one.

    A node that ends at column zero of the next line does not occupy
    it. Kconfig's `config THING` ends where `config THING_SIZE`
    begins, and taking the end row as it comes put the next entry's
    first line inside the previous entry's text and citation.
    """
    row, column = node.end_point
    if column == 0 and row > node.start_point[0]:
        return row
    return row + 1


def declared(node: Node, units: frozenset[str]) -> bool:
    """A unit, and not the keyword that happens to share its name.

    Tree-sitter gives an anonymous token the text it matched as its
    type, so Kconfig's `menu` keyword and Kconfig's menu node are both
    "menu". Without this the keyword was emitted as a unit of its own
    holding the word `menu`.
    """
    return node.is_named and node.type in units


def named(node: Node, units: frozenset[str]) -> str:
    """The first name inside the node, not reaching into a sub-unit.

    An override comes with it: bitbake's `do_install` and
    `do_install:append` are different tasks, and a citation naming
    both of them `do_install` sends the reader to the wrong one.
    """
    if node.type in NAMELESS:
        return f"lines {node.start_point[0] + 1}-{last_line(node)}"
    rest = list(node.children)
    while rest:
        child = rest.pop(0)
        if child.type in NAMES:
            found = text_of(child).strip('"')
            after = child.next_sibling
            if after is not None and after.type == "override":
                found += text_of(after)
            return found
        if child.type not in units:
            rest.extend(child.children)
    return ""


def holds_unit(node: Node, units: frozenset[str]) -> bool:
    """Whether a unit is anywhere below this node."""
    return any(
        declared(child, units) or holds_unit(child, units)
        for child in node.children
    )


def errors(node: Node) -> int:
    """How many characters sit inside an error or a missing token."""
    if node.type == "ERROR" or node.is_missing:
        return node.end_byte - node.start_byte
    if not node.has_error:
        return 0
    return sum(errors(child) for child in node.children)


def cut(
    lines: list[str], first: int, last: int, limit: int = UNIT_CHARS
) -> list[tuple[int, int, str]]:
    """A line range in pieces, each with the lines it really holds.

    Cutting by characters and keeping the original range made every
    piece claim the same lines, so a 600-character excerpt was cited
    as lines 1 to 1370. A piece is worth citing only if it can say
    where it starts.
    """
    out: list[tuple[int, int, str]] = []
    held: list[str] = []
    start = first
    room = 0
    for at in range(first, last + 1):
        line = lines[at - 1] if at - 1 < len(lines) else ""
        if held and room + len(line) + 1 > limit:
            out.append((start, at - 1, "\n".join(held)))
            held, room, start = [], 0, at
        held.append(line)
        room += len(line) + 1
    if held:
        out.append((start, last, "\n".join(held)))
    return out or [(first, last, "")]


def body(lines: list[str], node: Node) -> str:
    return "\n".join(lines[node.start_point[0] : last_line(node)])


def collect(
    node: Node, lines: list[str], language: str, out: list[Unit]
) -> None:
    """Walk one level, emitting units and grouping what is between.

    A run of nodes that are no unit of their own becomes one: in C
    that is the includes and the macros, in a recipe the variables the
    design notes call the recipe header, in a constraint file the
    commands between two procs.
    """
    units = UNITS.get(language, frozenset())
    inside = INSIDE.get(language, frozenset())
    held: list[Node] = []

    def flush() -> None:
        if not held:
            return
        first, last = held[0].start_point[0], last_line(held[-1]) - 1
        text = "\n".join(lines[first : last + 1])
        held.clear()
        if len(text.strip()) < MIN_GROUP:
            return
        for begins, ends, piece in cut(lines, first + 1, last + 1):
            out.append(
                Unit(
                    "declarations",
                    f"lines {begins}-{ends}",
                    begins,
                    ends,
                    piece,
                )
            )

    for child in node.children:
        if child.type in CLEAR or (
            not declared(child, units) and holds_unit(child, units)
        ):
            flush()
            collect(child, lines, language, out)
            continue
        if not declared(child, units):
            if text_of(child):
                held.append(child)
            elif holds_unit(child, units):
                flush()
                collect(child, lines, language, out)
            continue
        flush()
        name = named(child, units)
        if child.type in inside:
            held_in: list[Unit] = []
            collect(child, lines, language, held_in)
            own = [u for u in held_in if u.kind != "declarations"]
            if own:
                head = [u for u in held_in if u.kind == "declarations"]
                first = child.start_point[0] + 1
                for one in head[:1]:
                    out.append(
                        Unit(
                            f"{child.type} header",
                            name or one.name,
                            first,
                            one.last_line,
                            one.text,
                        )
                    )
                out.extend(
                    Unit(
                        u.kind,
                        ".".join(part for part in (name, u.name) if part),
                        u.first_line,
                        u.last_line,
                        u.text,
                    )
                    for u in own
                )
                continue
        pieces = cut(lines, child.start_point[0] + 1, last_line(child))
        for at, (begins, ends, piece) in enumerate(pieces):
            out.append(
                Unit(
                    child.type,
                    name + (f" lines {begins}-{ends}" if at else ""),
                    begins,
                    ends,
                    piece,
                )
            )
    flush()


def bare(text: str) -> str:
    """A reference as a name: no quotes and no angle brackets.

    A scoped path is kept whole. `std::io::Write` cut to `std` loses
    what was imported and cut to `Write` loses where from; the lookup
    matches a prefix, so the whole path answers a question about
    either end of it.
    """
    return text.strip().strip("\"'<>").strip()


def tail(text: str) -> str:
    """The last meaningful part of a dotted reference."""
    parts = [one for one in bare(text).split(".") if one not in TAIL_SKIP]
    return parts[-1] if parts else ""


# Stands in for an expansion cut out of a value. Any word it touches
# was partly computed by bitbake and is not a recipe name.
HOLE = "\x00"


def unexpanded(value: str) -> str:
    """The value with every ${...} replaced, nesting and all.

    Skipping a word that holds a `${` is not enough, because an
    expansion can hold whitespace. Measured over
    meta-virtualization: `${@bb.utils.contains('XEN_TARGET_ARCH',
    'x86_64', 'dev86-native', '', d)}` is five words, only the first
    of which holds the `${`, so `'x86_64',` and `'dev86-native',`
    both entered the graph as recipes nothing depends on.
    """
    out = []
    depth = 0
    at = 0
    while at < len(value):
        if value.startswith("${", at):
            depth += 1
            at += 2
            continue
        if depth and value[at] == "}":
            depth -= 1
            at += 1
            if not depth:
                out.append(HOLE)
            continue
        if not depth:
            out.append(value[at])
        at += 1
    return "".join(out)


def listed(value: str) -> list[str]:
    """The recipe names inside a bitbake list, variables left alone."""
    out = []
    for word in unexpanded(bare(value)).split():
        if HOLE in word or not word.strip("\\"):
            continue
        out.append(word)
    return out


def words_of(node: Node) -> list[Node]:
    """A Tcl or shell command's words, in order."""
    out = []
    for child in node.children:
        if child.is_named:
            out.append(child)
    return out


def edges(
    node: Node, language: str, known: set[str], out: list[Edge]
) -> None:
    """Walk the whole tree, collecting what it refers to.

    The whole tree and not one level: a call sits inside a function
    body and an instantiation inside an architecture, which is the
    point of having a tree.
    """
    wanted = EDGES.get(language, {})
    kind = wanted.get(node.type) if node.is_named else None
    if kind == "include" and node.type == "mod_item":
        # `mod helpers;` names another file; `mod helpers { ... }`
        # declares one here and is a unit rather than an edge.
        if any(c.type == "declaration_list" for c in node.children):
            kind = None
    if kind:
        _edge(node, kind, language, out)
    elif node.is_named and node.type == "variable_assignment":
        _bitbake_variable(node, language, out)
    # A command only. A `proc` declaration is a unit and reads as a
    # call of its own name otherwise, which put every proc in the
    # graph as calling itself on the line that defines it.
    elif node.is_named and node.type == "command":
        _command(node, language, known, out)
    for child in node.children:
        edges(child, language, known, out)


def _edge(node: Node, kind: str, language: str, out: list[Edge]) -> None:
    line = node.start_point[0] + 1
    if kind in {"inherit", "require"}:
        for child in node.children:
            if child.type in {"inherit_path", "include_path"}:
                out.append(Edge(kind, bare(text_of(child)), line))
        return
    for child in node.children:
        if not child.is_named:
            continue
        found = text_of(child)
        if kind == "include":
            out.append(Edge(kind, bare(found).split("/")[-1], line))
        elif language == "vhdl":
            out.append(Edge(kind, tail(found), line))
        else:
            out.append(Edge(kind, bare(found), line))
        return


def _bitbake_variable(node: Node, language: str, out: list[Edge]) -> None:
    """DEPENDS and its relatives as edges, and every set as an assign.

    Every assignment is recorded, not only the dependency lists: the
    question M5 asks is which layer overrides a variable, and that
    needs the ones nobody thought to enumerate.
    """
    if language != "bitbake":
        return
    line = node.start_point[0] + 1
    children = [c for c in node.children if c.is_named]
    if not children:
        return
    # The override is part of the variable, not noise beside it.
    # "which layer overrides RDEPENDS:${PN}" is the question M5 asks,
    # and an edge reading "RDEPENDS" cannot answer it.
    name = text_of(children[0])
    if len(children) > 1 and children[1].type == "override":
        name += text_of(children[1])
    out.append(Edge("assign", name, line))
    plain = name.split(":")[0]
    if plain in BITBAKE_LISTS and len(children) > 1:
        for one in listed(text_of(children[-1])):
            out.append(Edge(plain.lower(), one, line))


def _command(
    node: Node, language: str, known: set[str], out: list[Edge]
) -> None:
    """A shell or Tcl command: a source, a call, or neither.

    A call is recorded only for a name the file defines itself.
    Everything in a shell script is a command, and `ls` is not an edge
    in anybody's graph; a proc the file declares and then uses is.
    """
    pulls = SOURCES.get(language, frozenset())
    if not pulls:
        return
    spoken = words_of(node)
    if not spoken:
        return
    first = text_of(spoken[0])
    line = node.start_point[0] + 1
    if first in pulls and len(spoken) > 1:
        out.append(
            Edge("source", bare(text_of(spoken[1])).split("/")[-1], line)
        )
    elif first in known:
        out.append(Edge("call", first, line))


def by_line(lines: list[str]) -> list[Unit]:
    """The fallback: blank-line blocks, with the lines they came from."""
    out: list[Unit] = []
    held = False
    start = 1
    for number, line in enumerate(lines, start=1):
        if line.strip():
            if not held:
                start, held = number, True
            continue
        if held:
            for begins, ends, piece in cut(lines, start, number - 1):
                out.append(
                    Unit("block", f"lines {begins}-{ends}", begins, ends,
                         piece)
                )
            held = False
    if held:
        for begins, ends, piece in cut(lines, start, len(lines)):
            out.append(
                Unit("block", f"lines {begins}-{ends}", begins, ends, piece)
            )
    return out


def chunk(path: Path) -> dict[str, object]:
    language = language_of(path)
    data = path.read_bytes()
    lines = data.decode(errors="replace").splitlines()
    if not language:
        return {
            "file": path.name,
            "language": "",
            "how": "lines",
            "why": "no grammar for this name or suffix",
            "error_share": 0.0,
            "units": [asdict(u) for u in by_line(lines)],
        }
    tree = get_parser(language).parse(data)
    share = round(errors(tree.root_node) / max(1, len(data)), 3)
    units: list[Unit] = []
    collect(tree.root_node, lines, language, units)
    # Collected whatever happened to the units: a file the grammar
    # could not cut into units may still have had its includes and
    # instantiations read correctly, and the graph is the more robust
    # half.
    found: list[Edge] = []
    known = {unit.name.split(".")[-1] for unit in units if unit.name}
    edges(tree.root_node, language, known, found)
    seen: dict[tuple[str, str, int], Edge] = {
        (one.kind, one.name, one.line): one for one in found if one.name
    }
    graph = [asdict(one) for one in seen.values()]
    why = useless(units, len(lines), language)
    if why:
        return {
            "file": path.name,
            "language": language,
            "how": "lines",
            "why": why,
            "error_share": share,
            "units": [asdict(u) for u in by_line(lines)],
            "edges": graph,
        }
    return {
        "file": path.name,
        "language": language,
        "how": "tree-sitter",
        "error_share": share,
        "units": [asdict(u) for u in units],
        "edges": graph,
    }


def useless(units: list[Unit], lines: int, language: str) -> str:
    """Why the tree is not worth using, or the empty string.

    Error nodes are not the test. A grammar that misses a construct
    still puts the functions around it in the right place, and a
    grammar that misses the language puts the file in one nameless
    group; the second is the one to refuse.
    """
    if not units:
        return f"the {language} grammar found no units in the file"
    if any(unit.kind != "declarations" for unit in units):
        return ""
    # The share before cutting, not after: a thousand-line group split
    # into six still means the grammar named nothing, and judging the
    # pieces was how blame.tcl passed a test written to catch it.
    held = sum(unit.last_line - unit.first_line + 1 for unit in units)
    if lines and held / lines > MAX_GROUP_SHARE:
        return (
            f"the {language} grammar named nothing in the file and left "
            f"{held} of its {lines} lines in unnamed pieces"
        )
    return ""


def main(argv: list[str]) -> int:
    configure(PackConfig(cache_dir=GRAMMARS))
    if len(argv) != 2:
        print("usage: shuttle-chunk FILE", file=sys.stderr)
        return 2
    path = Path(argv[1])
    if not path.is_file():
        print(f"cannot read {path}", file=sys.stderr)
        return 2
    json.dump(chunk(path), sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
