# Example only: install.sh quadlets writes the real unit.
[Unit]
Description=SHUTTLE long llama-server

[Container]
Image=ghcr.io/ggml-org/llama.cpp:server-cuda
ContainerName=shuttle-long
Network=shuttle.network:ip=10.89.7.10
EnvironmentFile=/home/USER/.config/shuttle/long.env
Volume=/home/USER/.local/share/shuttle/models:/models:ro,z
Volume=/home/USER/.local/share/shuttle/cache/long:/cache:rw,Z
Exec=--slot-save-path /cache --flash-attn on --no-webui --cache-type-k q8_0 --cache-type-v q8_0
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:8080/health
HealthInterval=30s
HealthStartPeriod=900s
AddDevice=nvidia.com/gpu=all
PublishPort=127.0.0.1:8081:8080

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
